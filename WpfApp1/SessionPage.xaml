<Page x:Class="WpfApp1.SessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="Выбор мест">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Beige" Padding="20" 
                    Margin="0,0,0,20" BorderBrush="Orchid" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,30,0">
                        <TextBlock Text="Фильм:" FontSize="16" FontWeight="Bold"
                                   Foreground="DimGray" Margin="0,0,10,0"/>
                        <TextBlock x:Name="FilmNameTextBlock" FontSize="16" Foreground="Orchid"
                                   VerticalAlignment="Center"/>
                    </StackPanel>


                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <TextBlock Text="Дата:" FontWeight="Bold" Foreground="DimGray" 
                                       Margin="0,0,5,0"/>
                            <TextBlock x:Name="DateTextBlock" Foreground="Orchid"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <TextBlock Text="Время:" FontWeight="Bold" Foreground="DimGray"
                                       Margin="0,0,5,0"/>
                            <TextBlock x:Name="TimeTextBlock" Foreground="Orchid" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="HallNumberTextBlock" Foreground="DimGray"/>
                            <TextBlock Text=" (" Foreground="DimGray"/>
                            <TextBlock x:Name="RatingNameTextBlock" Foreground="DimGray" FontWeight="Bold"/>
                            <TextBlock Text=")" Foreground="DimGray"/>
                        </StackPanel>
                    </StackPanel>


                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Цена:" FontWeight="Bold" Foreground="DimGray" Margin="0,0,5,0"/>
                        <TextBlock x:Name="PriceTextBlock" Foreground="Orchid"  FontSize="16"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="Beige" Padding="15" 
                    Margin="0,0,0,20" BorderBrush="Orchid" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Border Width="20" Height="20" Background="White" BorderBrush="DimGray" 
                                    BorderThickness="1" Margin="0,0,5,0"/>
                            <TextBlock Text="Свободно" Foreground="DimGray" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Border Width="20" Height="20" Background="Orchid" Margin="0,0,5,0"/>
                            <TextBlock Text="Выбрано" Foreground="DimGray" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" Background="Gray" Margin="0,0,5,0"/>
                            <TextBlock Text="Занято" Foreground="DimGray" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>


                    <Button Grid.Column="2" x:Name="ClearButton"
                            Content="Убрать все выбранные места" Background="Orchid" Foreground="White"
                            BorderThickness="0" Padding="15,8" Cursor="Hand" Click="ClearButton_Click" >
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="Beige" Padding="15" 
                    Margin="0,0,0,20" BorderBrush="Orchid" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Экран" FontSize="14" FontWeight="Bold" Foreground="DimGray"
                               HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <Border Height="5" Background="DimGray" Margin="0,0,0,30" Width="400" HorizontalAlignment="Center"/>


                    <ListBox x:Name="SeatsByRow" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" >
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                                    <TextBlock Text="{Binding RowNumber}" 
                                               FontWeight="Bold" Foreground="DimGray" Width="30" 
                                               VerticalAlignment="Center"/>

                                    <ItemsControl ItemsSource="{Binding Seats}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="40" Height="40" Margin="5,0" Padding="0"
                                                        BorderThickness="1" BorderBrush="DimGray" Background="{Binding BackgroundColor}"
                                                        Foreground="Black" FontSize="12" FontWeight="Bold"
                                                        Click="SeatButton_Click" Tag="{Binding}">
                                                    <TextBlock Text="{Binding SeatNumber}" HorizontalAlignment="Center"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="Beige" Padding="15" 
                    Margin="0,0,0,20" BorderBrush="Orchid" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Выбрано мест: " FontSize="16" Foreground="DimGray"/>
                        <TextBlock x:Name="SelectedCountTextBlock" Text="0" FontSize="16" 
                                   FontWeight="Bold" Foreground="Orchid" Margin="0,0,20,0"/>
                        <TextBlock Text="Сумма: " FontSize="16" Foreground="DimGray"/>
                        <TextBlock x:Name="TotalPriceTextBlock" Text="0 ₽" FontSize="16" 
                                   FontWeight="Bold" Foreground="Orchid"/>
                    </StackPanel>


                    <Button Grid.Column="1" x:Name="BookButton" Content="Оформить билет" 
                            Background="Orchid" Foreground="Beige" BorderThickness="0"
                            Padding="25,12" FontSize="14" FontWeight="Bold" Cursor="Hand" IsEnabled="False" 
                            Height="43" VerticalAlignment="Top" Click="BookButton_Click" >
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
