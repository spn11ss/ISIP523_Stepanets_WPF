<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WpfApp1.Step5_Order"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Шаг5_Order"
      d:DesignHeight="500" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Шаг 5: Оформление заявки"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="Контактные данные:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel>
                <TextBlock Text="Имя:"/>
                <TextBox x:Name="NameTextBox" Margin="0,5"/>

                <TextBlock Text="Телефон (только цифры):"/>

                <TextBox x:Name="PhoneTextBox" Margin="0,5"
                         PreviewTextInput="PhoneTextBox_PreviewTextInput"
                         PreviewKeyDown="PhoneTextBox_PreviewKeyDown"/>

                <TextBlock Text="Email:"/>
                <TextBox x:Name="EmailTextBox" Margin="0,5"/>
            </StackPanel>

            <TextBlock Text="Итоговая сводка:" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>

            <StackPanel x:Name="SummaryPanel" Margin="0,0,0,20"/>
        </StackPanel>
    </Grid>
</Page>