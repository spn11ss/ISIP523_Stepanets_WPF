<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Кинотеатр" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Beige" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Content="← Назад" 
                        Background="Transparent" Foreground="DimGray" 
                        BorderThickness="0" Cursor="Hand" Margin="5,0,15,0" 
                        Visibility="Collapsed" Click="BackButton_Click"/>
                <TextBlock x:Name="PageTitleTextBlock" Grid.Column="1" Text="Главная страница" 
                           Foreground="Orchid" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="UserInfoTextBlock" Text="Гость" 
                               Foreground="DimGray" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    
                    <Button x:Name="AuthButton" Content="Войти" Background="Orchid" 
                            Foreground="Beige" BorderThickness="0"
                            Padding="15,5" Cursor="Hand" Click="AuthButton_Click"/>
                    
                    <Button x:Name="ProfileButton" Content="Профиль" Background="Orchid" 
                            Foreground="Beige" BorderThickness="0"
                            Padding="15,5" Margin="10,0,0,0" Cursor="Hand" Visibility="Collapsed" 
                            Click="ProfileButton_Click" />

                    <Button x:Name="LogoutButton" Content="Выйти" Background="DimGray" 
                            Foreground="Beige" BorderThickness="0" Padding="15,5"
                            Margin="10,0,0,0" Cursor="Hand" Visibility="Collapsed" 
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <Frame x:Name="MainFrame" Grid.Row="1" 
               NavigationUIVisibility="Hidden"
               Navigated="MainFrame_Navigated"/>
    </Grid>
</Window>
