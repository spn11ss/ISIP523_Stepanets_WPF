<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Background="#e0ffff"
        Title="Парфюмерный магазин" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="LightBlue" Height="50">
            <Button x:Name="BProduct" Content="Продукция" Width="100" Height="30" 
                    FontFamily="Dubai" FontWeight="Bold" Foreground="#000080" 
                    Background="#e0ffff" BorderBrush="#000080"
                    FontSize="14" Margin="10,0,0,0" Click="BProduct_Click"/>
            <Button x:Name="BKorzina" Content="Корзина" Width="100" Height="30" 
                    FontFamily="Dubai" FontWeight="Bold" Foreground="#000080" 
                    Background="#e0ffff" BorderBrush="#000080"
                    FontSize="14" Margin="10,0,0,0" Click="BKorzina_Click"/>
            <Button x:Name="BOrder" Content="Оформление заказа" Width="150" Height="30" 
                    FontFamily="Dubai" FontWeight="Bold" Foreground="#000080" 
                    Background="#e0ffff" BorderBrush="#000080"
                    FontSize="14" Margin="10,0,0,0" Click="BOrder_Click" />
        </StackPanel>

        <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden" 
         Navigated="MainFrame_OnNavigated" Margin="10"/>
    </Grid>
</Window>
