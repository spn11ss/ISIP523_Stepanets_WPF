<Page x:Class="WpfApp1.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Главная страница">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center"
            Orientation="Horizontal" Margin="0,0,0,10">

            <Button x:Name="ClearButton" Content="Сбросить" Width="70"
                    Height="30" Margin="0,0,10,0" Background="Orchid" Foreground="White"
                    BorderThickness="0" Click="ClearButton_Click" >
            </Button>
            
            <TextBox x:Name="SearchTextBox" Width="200" Height="30" Padding="5"
              TextChanged="SearchTextBox_TextChanged"/>

        </StackPanel>

        <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal" Margin ="0,0,0,10">
            <TextBlock Text="Сортировать: " Foreground="DimGray"/>
            <RadioButton x:Name="SortByName" Content="по названию" Foreground="DimGray" Checked="SortByName_Checked" />
            <RadioButton x:Name="SortByRating" Content="по рейтингу" Foreground="DimGray" Checked="SortByRating_Checked"/>
        </StackPanel>


        <ListBox x:Name="CinemaListBox" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent" BorderThickness="0" SelectionChanged="CinemaListBox_SelectionChanged">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Orchid" BorderThickness="1" Margin="5" Padding="10" 
                            Background="Beige" Width="220">

                        <StackPanel>

                            <Border Height="150" Margin="0,0,0,10" Background="Beige">
                                
                                <Image Source="{Binding Image}" Stretch="Uniform" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       Height="140" Width="200"/>
                            </Border>


                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextAlignment="Center" 
                                       Foreground="Orchid" Margin="0,5" TextWrapping="Wrap" MaxHeight="40"/>
                            
                            <ItemsControl ItemsSource="{Binding GenresCinema}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Genres.Name}" Margin="0,0,5,0" FontStyle="Italic"
                                                   Foreground="DimGray"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                                
                                <TextBlock Text="Рейтинг: " Foreground="DimGray"/>
                               
                                <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}" 
                                   Foreground="Orchid" 
                                   FontWeight="Bold"/>
                                
                                <TextBlock Text="/10" Foreground="DimGray"/>
                            </StackPanel>


                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                                
                                <TextBlock Text="Премьера: " Foreground="DimGray"/>
                                
                                <TextBlock Text="{Binding DateStart, StringFormat='dd.MM.yyyy'}" 
                                   Foreground="#27AE60"/>
                            </StackPanel>


                            <Border Background="DimGray" Padding="5" Margin="0,5" HorizontalAlignment="Center">
                                
                                <TextBlock Text="{Binding AgeRating.Name}" Foreground="White" 
                                           FontWeight="Bold" FontSize="11"/>
                            </Border>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>



    </Grid>
</Page>
