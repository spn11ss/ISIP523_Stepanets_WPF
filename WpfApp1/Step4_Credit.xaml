<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WpfApp1.Step4_Credit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Шаг4_Credit"
      Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок шага -->
        <Border Grid.Row="0" Background="#DB4D92" CornerRadius="5" Padding="15" Margin="0,0,0,20">
            <TextBlock Text="Шаг 4: Настройка кредита" 
                       FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Основное содержимое (растягивается) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- Стоимость автомобиля -->
                <Border BorderBrush="#DB4D92" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Стоимость автомобиля:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TotalPriceText" FontSize="24" FontWeight="Bold" 
                                   Foreground="#DB4D92" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Первоначальный взнос -->
                <Border BorderBrush="#DB4D92" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Первоначальный взнос:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Slider x:Name="DownPaymentSlider" Minimum="10" Maximum="90" Value="20"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="DownPaymentSlider_ValueChanged"
                                Margin="0,10,0,10"
                                Background="#FFB6C1"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="DownPaymentPercentText" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Left" Foreground="Aqua"/>

                            <TextBlock x:Name="DownPaymentAmountText" FontSize="16" FontWeight="Bold"
                                       Grid.Column="1" HorizontalAlignment="Right" Foreground="CadetBlue"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Срок кредита -->
                <Border BorderBrush="#DB4D92" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Срок кредита (месяцев):" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Slider x:Name="TermSlider" Minimum="12" Maximum="96" Value="36"
                                TickFrequency="12" IsSnapToTickEnabled="True"
                                ValueChanged="TermSlider_ValueChanged"
                                Margin="0,10,0,10"
                                Background="#FFB6C1" />

                        <TextBlock x:Name="TermText" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Процентная ставка -->
                <Border BorderBrush="#DB4D92" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Годовая процентная ставка:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="LoanRateText" FontSize="18" FontWeight="Bold" 
                                   Foreground="#DB4D92" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Итоги кредита -->
                <Border BorderBrush="#DB4D92" BorderThickness="2" CornerRadius="5" Padding="20" 
                        Background="#F0F8FF" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Итоги кредита:" FontSize="18" FontWeight="Bold" 
                                   Foreground="#DB4D92" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Сумма кредита:" FontSize="16" Grid.Column="0"/>
                            <TextBlock x:Name="LoanAmountText" FontSize="16" FontWeight="Bold" Grid.Column="1" 
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Margin="0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Ежемесячный платёж:" FontSize="18" Grid.Column="0"/>
                            <TextBlock x:Name="MonthlyPaymentText" FontSize="22" FontWeight="Bold" 
                                       Foreground="#DB4D92" Grid.Column="1" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>



            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>