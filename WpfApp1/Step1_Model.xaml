<Page x:Class="WpfApp1.Step1_Model"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Шаг1_Model"
      d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Шаг 1: Выбор модели и двигателя" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="Модель автомобиля:" FontSize="14" Margin="0,5"/>
            <ComboBox x:Name="ModelComboBox" SelectionChanged="ModelComboBox_SelectionChanged">
                <ComboBoxItem Content="Седан (базовая цена: 20 000€)" Tag="20000"/>
                <ComboBoxItem Content="Хэтчбек (базовая цена: 22 000€)" Tag="22000"/>
                <ComboBoxItem Content="Внедорожник (базовая цена: 30 000€)" Tag="30000"/>
            </ComboBox>

            <TextBlock Text="Тип двигателя:" FontSize="14" Margin="0,20,0,5"/>
            <StackPanel>
                <RadioButton x:Name="PetrolEngine" Content="Бензиновый (+0€)" 
                            Checked="Engine_Checked" GroupName="Engine"/>
                <RadioButton x:Name="DieselEngine" Content="Дизельный (+1 500€)" 
                            Checked="Engine_Checked" GroupName="Engine"/>
                <RadioButton x:Name="ElectricEngine" Content="Электрический (+5 000€)" 
                            Checked="Engine_Checked" GroupName="Engine"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>