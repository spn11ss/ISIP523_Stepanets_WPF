<Page x:Class="WpfApp1.FilmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="800"
      Title="Информация о фильме"
      DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Beige" Padding="20" Margin="0,0,0,20"
                    BorderBrush="Orchid" BorderThickness="1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0" Height="400" Width="280" Background="Beige" 
                            HorizontalAlignment="Center" BorderBrush="DimGray" BorderThickness="1">
                        <Image Source="{Binding CurrentCinema.Image}" 
                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                               MaxHeight="390" MaxWidth="270"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding CurrentCinema.Name}" 
                                   FontSize="32" FontWeight="Bold" Foreground="Orchid"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Background="Orchid" Padding="15,8" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="★ " Foreground="Beige" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CurrentCinema.Rating, StringFormat={}{0:F1}}" 
                                               Foreground="Beige" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="DimGray" Padding="15,8">
                                <TextBlock Text="{Binding CurrentCinema.AgeRating.Name}" 
                                           Foreground="Beige" FontSize="14" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Жанры:" FontSize="16" FontWeight="Bold" Foreground="DimGray"
                                       Margin="0,0,0,5"/>
                            <ItemsControl ItemsSource="{Binding CurrentCinema.GenresCinema}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="10,5" Margin="0,0,8,5">
                                            <TextBlock Text="{Binding Genres.Name}" 
                                                       Foreground="DimGray" FontSize="13"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="О фильме:" FontSize="16" FontWeight="Bold" 
                                       Foreground="DimGray" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding CurrentCinema.Description}" 
                                       TextWrapping="Wrap" FontSize="14" Foreground="DimGray"
                                       LineHeight="20"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" Padding="20" BorderBrush="Orchid" 
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Сеансы" FontSize="24" FontWeight="Bold" Foreground="DimGray" 
                               Margin="0,0,0,20"/>

                    <ListBox x:Name="SessionsListBox" ItemsSource="{Binding Sessions}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="SessionsListBox_SelectionChanged">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Beige" Padding="15" Margin="0,0,0,10" 
                                        BorderBrush="Orchid" BorderThickness="1" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>


                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                            <TextBlock Text="{Binding DateTime, StringFormat='dd.MM.yyyy'}" 
                                                       FontSize="16" FontWeight="Bold" Foreground="Orchid"/>
                                        </StackPanel>


                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                                            <TextBlock Text="{Binding DateTime, StringFormat='HH:mm'}" 
                                                       FontSize="16" FontWeight="Bold" Foreground="Orchid"/>
                                        </StackPanel>


                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding HallNumber}" 
                                                       FontWeight="Bold" Foreground="DimGray" Margin="0,0,10,0"/>
                                            
                                        </StackPanel>


                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <TextBlock Text="{Binding ChairPrice, StringFormat={}{0} ₽}" 
                                                       FontSize="16" FontWeight="Bold" Foreground="Orchid" Margin="0,0,5,0"/>
                                            <TextBlock Text="за место" Foreground="DimGray" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding RatingName}" FontWeight="Bold" Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="200"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
