<Page x:Class="WpfApp1.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Вход в систему">

    <Grid Background="Transparent">
        <Border Width="400" Height="300" Background="Beige"
                BorderBrush="Orchid" BorderThickness="1" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <StackPanel Margin="20" >
                <TextBlock Text="Вход в систему" FontSize="24" 
                           FontWeight="Bold" Foreground="Orchid" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Логин" Foreground="DimGray" Margin="0,0,0,5"/>
                <TextBox x:Name="LoginTextBox" Height="30" Padding="5" 
                         BorderBrush="Orchid" Foreground="DimGray" BorderThickness="1" 
                         Margin="0,0,0,15"/>

                <TextBlock Text="Пароль" Foreground="DimGray" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" Height="30" Padding="5" 
                         BorderBrush="Orchid" Foreground="DimGray" BorderThickness="1" 
                         Margin="0,0,0,15"/>
                
                <Button x:Name="LoginButton" Content="Войти" Height="30" 
                        Background="Orchid" Foreground="Beige" FontWeight="Bold" 
                        FontSize="14" BorderThickness="0" Margin="0,0,0,25" Click="LoginButton_Click"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                    
                    <TextBlock Text="Нет аккаунта?" Foreground="DimGray" Margin="0,0,5,0"/>
                    
                    <Button x:Name="RegisterLinkButton" Content="Зарегистрироваться"
                            Background="Transparent" BorderThickness="0" 
                            Foreground="Orchid" Cursor="Hand" Click="RegisterLinkButton_Click"/>
                    
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
