<Page x:Class="WpfApp1.Page2_Korzina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page2_Korzina">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="10" Margin="0,0,0,10">
            <TextBlock Text="Корзина" FontSize="20" FontFamily="Dubai" FontWeight="Bold" Foreground="#000080" HorizontalAlignment="Center"/>

        </Border>
        <ListBox Grid.Row="1"  x:Name="Page2LstBx" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="#e0ffff" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <ItemContainerTemplate>
                    <Border CornerRadius="5" Margin="0,5,0,5" Padding="10" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="100" Height="100" 
                                    Margin="0,0,10,0" CornerRadius="5" Background="#F5F5F5">
                                <Image Source="{Binding Picture}" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>


                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontFamily="Dubai" FontSize="16" 
                                           FontWeight="Bold" Foreground="#333333"/>

                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0} руб.'}" 
                                           FontFamily="Dubai" Foreground="Green" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            </StackPanel>


                            <Button Grid.Column="2" Content="Удалить" Width="80" Height="30" FontFamily="Dubai"
                                    Background="#FF4444" Foreground="White" Margin="10,0,0,0" 
                                    VerticalAlignment="Bottom" Click="ButtonRemove_Click" />
                        </Grid>
                    </Border>
                </ItemContainerTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <Border Grid.Row="2" Background="#F0F0F0" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Итого: " Foreground="#000080" FontFamily="Dubai" FontSize="16" FontWeight="Bold" 
                               VerticalAlignment="Center" Margin="0,0,5,0"/>

                    <TextBlock x:Name="Final_PriceTxt" Text="0 ₽" FontSize="16" FontWeight="Bold" 
                               FontFamily="Dubai" Foreground="Green" VerticalAlignment="Center" Margin="0,0,20,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="OrderButton"
                        Content="Оформить заказ" Width="120" Height="35" Background="#4CAF50" 
                        Foreground="White" FontFamily="Dubai" FontWeight="Bold" Click="OrderButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
