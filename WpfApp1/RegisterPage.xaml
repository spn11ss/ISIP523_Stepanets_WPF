<Page x:Class="WpfApp1.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Регистрация">

    <Grid>
        <Grid Background="Transparent">
            <Border Width="400" Height="450" Background="Beige"
            BorderBrush="Orchid" BorderThickness="1" 
            HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel Margin="15" >
                    <TextBlock Text="Регистрация" FontSize="24" 
                       FontWeight="Bold" Foreground="Orchid" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,0,0,15"/>

                    <TextBlock Text="Имя" Foreground="DimGray" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameTextBox" Height="30" Padding="5" 
                             BorderBrush="Orchid" Foreground="DimGray" BorderThickness="1" 
                             Margin="0,0,0,10"/>


                    <TextBlock Text="Логин" Foreground="DimGray" Margin="0,0,0,5"/>
                    <TextBox x:Name="LoginTextBox" Height="30" Padding="5" 
                             BorderBrush="Orchid" Foreground="DimGray" BorderThickness="1" 
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Почта" Foreground="DimGray" Margin="0,0,0,5"/>
                    <TextBox x:Name="MailTextBox" Height="30" Padding="5" 
                             BorderBrush="Orchid" Foreground="DimGray" BorderThickness="1" 
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Пароль" Foreground="DimGray" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox" Height="30" Padding="5" 
                                 BorderBrush="Orchid" Foreground="DimGray" BorderThickness="1" 
                                 Margin="0,0,0,10"/>

                    <TextBlock Text="Подтвердите пароль" Foreground="DimGray" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Height="30" Padding="5" 
                                 BorderBrush="Orchid" Foreground="DimGray" BorderThickness="1" 
                                 Margin="0,0,0,15"/>

                    <Button x:Name="RegisterButton" Content="Зарегистрироваться" Height="30" 
                            Background="Orchid" Foreground="Beige" FontWeight="Bold" 
                            FontSize="14" BorderThickness="0" Margin="0,0,0,8" Click="RegisterButton_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <TextBlock Text="Есть аккаунт?" Foreground="DimGray" Margin="0,0,5,0"/>
                        <Button x:Name="RegisterLinkButton" Content="Войти"
                                Background="Transparent" BorderThickness="0" 
                                Foreground="Orchid" Cursor="Hand" Click="RegisterLinkButton_Click"/>

                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
